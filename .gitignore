# ABOUTME: Git ignore rules: blocks data/, output/, secrets, and ALL *.json/*.csv/*.png result files.
# ABOUTME: Results are published to the multicot org on Hugging Face, never committed — do not git add -f around this.
*.pkl
*.json
*.zip
*.png
*.npy
*.pyc
*.csv
*.lock
plots/*
math-rollouts/
math-rollouts_test/
.claude/
local/
.cursorindexingignore
.specstory

# Python (from multicot/.gitignore)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Environment
.env

# Data (keep structure, ignore large files)
data/raw/*
!data/raw/.gitkeep

# Runs and outputs
runs/
figures/*.png
figures/*.pdf

# Vertex per-run configs (contain injected API keys)
configs/vertex/runs/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Caches
.cache/
*.pkljar/
# macOS AppleDouble files
._*

# Run artifacts: local iteration only — the archive is the multicot org on HF
output/
# Staged inputs: pull from HF or rebuild (build_mgsm_subset)
data/
